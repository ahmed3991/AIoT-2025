{
  "version": 1,
  "author": "AI for IoT - Fire Alarm",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led_fire", "top": -30, "left": 200, "attrs": { "color": "red", "label": "FIRE" } },
    { "type": "wokwi-led", "id": "led_ok", "top": -30, "left": 260, "attrs": { "color": "green", "label": "OK" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 80, "left": 180, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 80, "left": 240, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz", "top": -40, "left": 330, "attrs": { "volume": "0.2" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:25", "r1:2", "red", [] ],
    [ "r1:1", "led_fire:A", "red", [] ],
    [ "led_fire:C", "esp:GND.1", "black", [] ],
    [ "esp:26", "r2:2", "green", [] ],
    [ "r2:1", "led_ok:A", "green", [] ],
    [ "led_ok:C", "esp:GND.1", "black", [] ],
    [ "esp:27", "bz:2", "orange", [] ],
    [ "bz:1", "esp:GND.1", "black", [] ]
  ]
}
